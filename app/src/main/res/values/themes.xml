        <item name="colorOnPrimary">@color/ls_on_primary</item>
        <item name="colorPrimaryContainer">@color/ls_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ls_on_primary_container</item>
        <item name="colorSecondary">@color/ls_secondary</item>
        <item name="colorOnSecondary">@color/ls_on_secondary</item>
        <item name="colorSecondaryContainer">@color/ls_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/ls_on_secondary_container</item>
        <item name="colorTertiary">@color/ls_tertiary</item>
        <item name="colorTertiaryContainer">@color/ls_tertiary_container</item>
        <item name="android:colorBackground">@color/ls_background</item>
