<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="22dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:alpha="0.35"
        android:background="@drawable/bg_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/backup_title"
        android:textColor="@color/ls_ink"
        android:textSize="26sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card_white"
        android:lineSpacingMultiplier="1.2"
        android:padding="18dp"
        android:text="@string/backup_body"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/ls_ink" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_pill_ink"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExport"
            style="@style/LS.Button.WhiteOnInk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/backup_export"
            app:icon="@drawable/ic_export"
            app:iconTint="@color/ls_ink" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImport"
            style="@style/LS.Button.WhiteOnInk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/ls_pink"
            android:text="@string/backup_import"
            app:icon="@drawable/ic_import"
            app:iconTint="@color/ls_ink" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/close"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="@color/ls_white" />
    </LinearLayout>
</LinearLayout>
