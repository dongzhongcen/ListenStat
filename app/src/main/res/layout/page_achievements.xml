<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="110dp">

        <TextView
            style="@style/LS.BigTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:text="@string/achievements_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/numUnlocked"
                style="@style/LS.BigNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0" />

            <TextView
                style="@style/LS.Unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ach_unlocked" />

            <TextView
                android:id="@+id/numTotal"
                style="@style/LS.BigNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0" />

            <TextView
                style="@style/LS.Unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ach_total" />
        </LinearLayout>

        <TextView
            style="@style/LS.Hand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:rotation="-3"
            android:text="@string/ach_hand" />

        <LinearLayout
            android:id="@+id/listAchievements"
            style="@style/LS.PeachCard"
            android:layout_marginTop="18dp"
            android:paddingTop="8dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
