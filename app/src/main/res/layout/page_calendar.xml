<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="110dp">

        <TextView
            style="@style/LS.BigTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:text="@string/calendar_title" />

        <TextView
            style="@style/LS.Hand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:rotation="-3"
            android:text="@string/calendar_hand" />

        <!-- Month navigator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPrevMonth"
                style="@style/LS.CircleButton"
                android:contentDescription="@string/prev_period"
                android:src="@drawable/ic_chevron_left" />

            <TextView
                android:id="@+id/txtMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/ls_ink"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/btnNextMonth"
                style="@style/LS.CircleButton"
                android:contentDescription="@string/next_period"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <!-- Weekday headers -->
        <LinearLayout
            android:id="@+id/weekdayRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />

        <!-- Calendar grid -->
        <GridLayout
            android:id="@+id/dayGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:columnCount="7"
            android:alignmentMode="alignBounds"
            android:useDefaultMargins="false" />

        <!-- Day detail -->
        <LinearLayout
            android:id="@+id/cardDayDetail"
            style="@style/LS.MintCard"
            android:layout_marginTop="18dp">

            <TextView
                android:id="@+id/txtDayLabel"
                style="@style/LS.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/calendar_pick_day" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/numDayHours"
                    style="@style/LS.BigNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0" />

                <TextView
                    style="@style/LS.Unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_hours" />

                <TextView
                    android:id="@+id/numDayMinutes"
                    style="@style/LS.BigNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0" />

                <TextView
                    style="@style/LS.Unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_minutes" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtDayEmpty"
                style="@style/LS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/calendar_day_empty"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/listSegments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
