<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_cream">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Cream veil over the wallpaper keeps dark text readable. -->
    <View
        android:id="@+id/wallpaperVeil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/ls_cream"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <include
        android:id="@+id/pageStats"
        layout="@layout/page_stats" />

    <include
        android:id="@+id/pageAchievements"
        layout="@layout/page_achievements"
        android:visibility="gone" />

    <include
        android:id="@+id/pageSettings"
        layout="@layout/page_settings"
        android:visibility="gone" />

    <include
        android:id="@+id/pageAppDetail"
        layout="@layout/page_app_detail"
        android:visibility="gone" />

    <!-- Small floating translucent pill navigation -->
    <LinearLayout
        android:id="@+id/navPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_nav_pill"
        android:orientation="horizontal"
        android:padding="6dp">

        <ImageButton
            android:id="@+id/navStats"
            style="@style/LS.CircleButton"
            android:contentDescription="@string/nav_stats"
            android:src="@drawable/ic_chart" />

        <ImageButton
            android:id="@+id/navAchievements"
            style="@style/LS.CircleButton"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/nav_achievements"
            android:src="@drawable/ic_trophy" />

        <ImageButton
            android:id="@+id/navSettings"
            style="@style/LS.CircleButton"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/nav_settings"
            android:src="@drawable/ic_tune" />
    </LinearLayout>
</FrameLayout>
