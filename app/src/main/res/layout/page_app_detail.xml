<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:clipToPadding="false"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="110dp">

        <!-- Back + app name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/LS.CircleButton"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_chevron_left" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_detail_caption"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/ls_muted" />

                <TextView
                    android:id="@+id/txtAppName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="@color/ls_ink" />
            </LinearLayout>
        </LinearLayout>

        <!-- Range chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipDay"
                    style="@style/LS.Chip"
                    android:text="@string/range_day" />

                <TextView
                    android:id="@+id/chipMonth"
                    style="@style/LS.Chip"
                    android:text="@string/range_month" />

                <TextView
                    android:id="@+id/chipYear"
                    style="@style/LS.Chip"
                    android:text="@string/range_year" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Period navigator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPrev"
                style="@style/LS.CircleButton"
                android:contentDescription="@string/prev_period"
                android:src="@drawable/ic_chevron_left" />

            <TextView
                android:id="@+id/txtPeriod"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_white"
                android:contentDescription="@string/pick_period"
                android:drawablePadding="8dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:tag="pill"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/ls_ink"
                app:drawableStartCompat="@drawable/ic_calendar"
                app:drawableTint="@color/ls_ink" />

            <ImageButton
                android:id="@+id/btnNext"
                style="@style/LS.CircleButton"
                android:contentDescription="@string/next_period"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/stripScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/strip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Totals + titles -->
        <LinearLayout
            android:id="@+id/stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTotalLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/ls_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/numHours"
                    style="@style/LS.BigNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/LS.Unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_hours" />

                <TextView
                    android:id="@+id/numMinutes"
                    style="@style/LS.BigNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/LS.Unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_minutes" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/numTitles"
                    style="@style/LS.MidNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/LS.Unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_titles" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_card_white"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="28dp"
                android:tag="glass"
                android:visibility="gone">

                <TextView
                    style="@style/LS.Hand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_hand"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/app_detail_empty_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/ls_ink" />

                <TextView
                    style="@style/LS.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/app_detail_empty_body" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardTitles"
                style="@style/LS.PeachCard"
                android:layout_marginTop="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp">

                    <TextView
                        style="@style/LS.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_app_titles" />

                    <TextView
                        style="@style/LS.Hand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hand_top" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/listTitles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
