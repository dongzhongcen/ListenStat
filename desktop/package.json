{
  "name": "listenstat-desktop",
  "productName": "ListenStat",
  "version": "0.1.0",
  "description": "ListenStat（听时）桌面端 — 按应用统计收听时长",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "preview": "vite preview",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "dist:win:dir": "npm run build && electron-builder --win dir --x64",
    "pack": "npm run dist:win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  },
  "build": {
    "appId": "com.dongzhongcen.listenstat",
    "productName": "ListenStat",
    "copyright": "Copyright (c) dongzhongcen",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ListenStat-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ListenStat"
    },
    "portable": {
      "artifactName": "ListenStat-${version}-portable.${ext}"
    }
  },
  "author": "dongzhongcen",
  "license": "MIT"
}
